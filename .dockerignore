# 依赖与构建产物（容器内重新安装/构建）
node_modules/
dist/
server/target/

# 本地数据库 / WAL（绝不打进镜像）
server/data/
*.db
*.db-wal
*.db-shm

# VCS 与 CI 杂项
.git/
.github/
.vscode/

# 本地环境与日志
.env
.env.*
*.log

# 注意：scripts/ 不能排除——npm prebuild 会执行 scripts/ensure-font.cjs
